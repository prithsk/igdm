# Copy to .env and fill in. Never commit the filled version.

# Your Instagram professional account ID
IG_ID=

# Long-lived Instagram user access token. maintain.py refreshes this.
IG_ACCESS_TOKEN=

# App secret from the Meta app dashboard. Verifies webhook signatures.
IG_APP_SECRET=

# Any string you choose. Must match what you enter in the webhook setup.
IG_VERIFY_TOKEN=

# 1 logs intended sends only. 0 actually messages people.
SHADOW=1

PORT=8000
